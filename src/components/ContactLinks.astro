---
import Icon from './icons/Icon.astro';
import BrandIcon from './icons/BrandIcon.astro';
import LinkedInIcon from './icons/LinkedInIcon.astro';
import { siGithub } from 'simple-icons';
import { EMAIL, GITHUB_URL, LINKEDIN_URL } from '../constants/contact';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  class?: string;
}

const { class: className = '' }: Props = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class={className}>
  <a href={`mailto:${EMAIL}`} class="flex items-center gap-2 hover:text-primary-500 transition-colors">
    <Icon name="Mail" size={16} />
    {EMAIL}
  </a>
  <div class="flex items-center gap-2">
    <Icon name="MapPin" size={16} />
    {t('hero.location')}
  </div>
  <a
    href={GITHUB_URL}
    target="_blank"
    rel="noopener noreferrer"
    class="flex items-center gap-2 hover:text-primary-500 transition-colors"
  >
    <BrandIcon icon={siGithub} size={16} class="shrink-0" />
    {t('hero.github')}
  </a>
  <a
    href={LINKEDIN_URL}
    target="_blank"
    rel="noopener noreferrer"
    class="flex items-center gap-2 hover:text-primary-500 transition-colors"
  >
    <LinkedInIcon size={16} class="shrink-0" />
    {t('hero.linkedin')}
  </a>
</div>
