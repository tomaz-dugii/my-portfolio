---
import { getImage, Image } from 'astro:assets';
import Icon from './icons/Icon.astro';
import type { PortfolioProject } from '../constants/portfolio';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  project: PortfolioProject;
  index: number;
}

const { project, index }: Props = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const background = index % 2 === 0 ? 'bg-bg-primary' : 'bg-bg-secondary';
const [heroImage, ...secondaryImages] = project.images;
const galleryName = `portfolio-gallery-${project.id}`;

const heroLightbox = await getImage({ src: heroImage, width: 2000, quality: 85 });
const secondaryLightbox = await Promise.all(
  secondaryImages.map((img) => getImage({ src: img, width: 2000, quality: 85 })),
);
---

<section
  id={project.id}
  class:list={['py-16 sm:py-24 scroll-mt-24', background]}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-10 lg:gap-14 items-start">
      <div class="lg:col-span-2 flex flex-col gap-5">
        <div class="flex items-center gap-4">
          <div
            class="w-14 h-14 rounded-xl overflow-hidden ring-1 ring-border-default bg-bg-tertiary flex items-center justify-center"
          >
            <Image
              src={project.logo}
              alt=""
              class="h-full w-full object-cover"
              width={56}
              height={56}
              sizes="56px"
              loading="lazy"
            />
          </div>
          <span
            class="inline-flex items-center gap-1.5 text-xs font-medium text-primary-300 bg-primary-500/10 dark:bg-primary-500/20 rounded-full px-3 py-1"
          >
            <Icon name="Calendar" size={12} />
            {t(project.durationKey)}
          </span>
        </div>

        <h2
          class="font-display text-3xl sm:text-4xl font-bold text-text-primary tracking-tight text-balance"
        >
          {t(project.titleKey)}
        </h2>

        <p class="text-base text-text-secondary leading-relaxed">
          {t(project.descriptionKey)}
        </p>

        <div class="pt-2">
          <p
            class="text-[11px] font-semibold tracking-[0.14em] uppercase text-text-muted mb-3"
          >
            {t('portfolio.stack')}
          </p>
          <ul class="flex flex-wrap gap-2">
            {
              project.stack.map((tech) => (
                <li class="text-xs font-medium px-2.5 py-1 rounded-md bg-primary-500/10 text-primary-600 dark:bg-primary-500/15 dark:text-primary-200 border border-primary-500/15">
                  {tech}
                </li>
              ))
            }
          </ul>
        </div>

        {
          project.link && (
            <div class="pt-2">
              <a
                href={project.link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-5 py-2.5 bg-primary-500 text-white font-medium rounded-lg hover:bg-primary-600 transition-colors"
              >
                <Icon name="ExternalLink" size={16} />
                {t(project.link.labelKey)}
              </a>
            </div>
          )
        }
      </div>

      <div class="lg:col-span-3">
        <div class="grid grid-cols-2 gap-3 sm:gap-4">
          <a
            href={heroLightbox.src}
            class="glightbox group relative col-span-2 block rounded-2xl overflow-hidden ring-1 ring-border-default bg-bg-tertiary outline-none focus-visible:ring-2 focus-visible:ring-primary-500"
            data-gallery={galleryName}
            aria-label={`${t(project.titleKey)} — ${t('portfolio.lightbox.openGallery')}`}
          >
            <Image
              src={heroImage}
              alt={t(project.titleKey)}
              class="h-full w-full object-cover aspect-[16/10] transition-transform duration-300 group-hover:scale-[1.02]"
              sizes="(min-width: 1024px) 55vw, 100vw"
              widths={[480, 800, 1200, 1600, 2000]}
              loading="lazy"
              decoding="async"
            />
          </a>
          {
            secondaryImages.map((image, i) => (
              <a
                href={secondaryLightbox[i].src}
                class="glightbox group relative block rounded-xl overflow-hidden ring-1 ring-border-default bg-bg-tertiary outline-none focus-visible:ring-2 focus-visible:ring-primary-500"
                data-gallery={galleryName}
                aria-label={t('portfolio.lightbox.openGallery')}
              >
                <Image
                  src={image}
                  alt=""
                  class="h-full w-full object-cover aspect-[4/3] transition-transform duration-300 group-hover:scale-[1.02]"
                  sizes="(min-width: 1024px) 25vw, 50vw"
                  widths={[400, 600, 800, 1200]}
                  loading="lazy"
                  decoding="async"
                />
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
