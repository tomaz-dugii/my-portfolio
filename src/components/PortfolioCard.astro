---
import { Image } from 'astro:assets';
import Icon from './icons/Icon.astro';
import type { PortfolioProject } from '../constants/portfolio';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

interface Props {
  project: PortfolioProject;
}

const { project }: Props = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const href = `${translatePath('/portfolio')}#${project.id}`;
---

<a
  href={href}
  class="group relative flex flex-col overflow-hidden rounded-xl border border-border-default bg-bg-secondary dark:bg-bg-secondary hover:border-primary-500/40 dark:hover:border-primary-500/40 hover:shadow-[0_8px_24px_-12px_rgba(46,64,54,0.25)] dark:hover:shadow-[0_8px_24px_-12px_rgba(0,0,0,0.6)] transition-all duration-300"
  aria-label={`${t(project.titleKey)} — ${t('portfolio.viewProject')}`}
>
  <div class="relative aspect-[16/10] overflow-hidden bg-bg-tertiary dark:bg-bg-tertiary">
    <Image
      src={project.cardImage}
      alt=""
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
      sizes="(min-width: 1280px) 400px, (min-width: 768px) 45vw, 100vw"
      widths={[400, 600, 800, 1200]}
    />
    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-t from-bg-primary/50 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"
    ></div>
  </div>

  <div class="flex flex-1 flex-col gap-3 p-5">
    <div class="flex items-start justify-between gap-3">
      <h3 class="font-display text-lg font-semibold text-text-primary leading-snug">
        {t(project.titleKey)}
      </h3>
      <span
        class="shrink-0 text-text-muted group-hover:text-primary-500 group-hover:translate-x-1 transition-all duration-300"
        aria-hidden="true"
      >
        <Icon name="ArrowRight" size={18} />
      </span>
    </div>

    <p class="text-sm text-text-tertiary">
      {t(project.subtitleKey)}
    </p>

    <ul class="mt-auto flex flex-wrap gap-1.5 pt-2">
      {
        project.stack.slice(0, 4).map((tech) => (
          <li class="text-[11px] font-medium tracking-wide uppercase px-2 py-0.5 rounded-md bg-primary-500/8 text-text-secondary border border-border-muted">
            {tech}
          </li>
        ))
      }
    </ul>
  </div>
</a>
